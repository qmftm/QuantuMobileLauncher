+// QuantuMobile: Android has no desktop GL; whatever the game asks for, hand out an OpenGL ES 3.2 context
+// (a GL->GLES translation layer sits on top in the launcher).
+static void QML_ForceES(SDL_VideoDevice *_this)
+{
+#ifdef SDL_VIDEO_DRIVER_ANDROID
+    if (_this->gl_config.profile_mask != SDL_GL_CONTEXT_PROFILE_ES) {
+        _this->gl_config.profile_mask = SDL_GL_CONTEXT_PROFILE_ES;
+        _this->gl_config.major_version = 3;
+        _this->gl_config.minor_version = 2;
+    }
+#endif
+}
+
 bool SDL_EGL_ChooseConfig(SDL_VideoDevice *_this)
 {
+    QML_ForceES(_this);
     if (!_this->egl_data) {
         return SDL_SetError("EGL not initialized");
     }
