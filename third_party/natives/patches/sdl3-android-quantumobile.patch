+// QuantuMobile: with SDL_ANDROID_BLOCK_ON_PAUSE=0 the game loop keeps running while the app is in the background (so the
+// server connection stays alive). The window surface goes away then, so the GL context is parked on a small off-screen
+// surface: the game can keep issuing GL calls, nothing is shown, and the context returns to the window on resume.
+static EGLSurface qm_bg_surface = EGL_NO_SURFACE;
+static bool qm_bg_active = false;
+
+bool Android_QM_RenderingInBackground(void)
+{
+    return qm_bg_active;
+}
+
+// Pauses/resumes the game's OpenAL device (the game does not use SDL audio) so it is silent in the background.
+static void qm_openal_pause(bool pause)
+{
+    const char *lib = SDL_getenv("QM_OPENAL_LIB");
+    void *handle = (lib && *lib) ? dlopen(lib, RTLD_NOW | RTLD_NOLOAD) : NULL;
+    if (handle) {
+        void *(*get_context)(void) = (void *(*)(void))dlsym(handle, "alcGetCurrentContext");
+        void *(*get_device)(void *) = (void *(*)(void *))dlsym(handle, "alcGetContextsDevice");
+        void (*toggle)(void *) = (void (*)(void *))dlsym(handle, pause ? "alcDevicePauseSOFT" : "alcDeviceResumeSOFT");
+        void *context = get_context ? get_context() : NULL;
+        void *device = (context && get_device) ? get_device(context) : NULL;
+        if (device && toggle) {
+            toggle(device);
+        }
+        SDL_LogWarn(SDL_LOG_CATEGORY_APPLICATION, "QM background: OpenAL %s device=%p", pause ? "pause" : "resume", device);
+        dlclose(handle);
+    }
+}
+
+static bool qm_egl_park_context(SDL_Window *window)
+{
+    SDL_VideoDevice *_this = SDL_GetVideoDevice();
+    SDL_WindowData *data = window->internal;
+    SDL_GLContext context = SDL_GL_GetCurrentContext();
+    int interval = 0;
+
+    if (!_this || !_this->egl_data || !context) {
+        return false;
+    }
+    if (qm_bg_surface == EGL_NO_SURFACE) {
+        qm_bg_surface = SDL_EGL_CreateOffscreenSurface(_this, 16, 16);
+    }
+    if (qm_bg_surface == EGL_NO_SURFACE) {
+        return false;
+    }
+    if (SDL_GL_GetSwapInterval(&interval)) {
+        data->has_swap_interval = 1;
+        data->swap_interval = interval;
+    }
+    if (!_this->egl_data->eglMakeCurrent(_this->egl_data->egl_display, qm_bg_surface, qm_bg_surface, (EGLContext)context)) {
+        SDL_LogWarn(SDL_LOG_CATEGORY_APPLICATION, "QM background: could not park the GL context (eglError=0x%x)", (unsigned)_this->egl_data->eglGetError());
+        return false;
+    }
+    data->egl_context = (EGLContext)context;
+    data->backup_done = true; // the window surface is free to be destroyed
+    qm_bg_active = true;
+    SDL_LogWarn(SDL_LOG_CATEGORY_APPLICATION, "QM background: GL context %p parked off-screen, game keeps running", (void *)context);
+    return true;
+}
+
+static bool qm_egl_unpark_context(SDL_Window *window)
+{
+    SDL_VideoDevice *_this = SDL_GetVideoDevice();
+    SDL_WindowData *data = window->internal;
+    bool ok = false;
+
+    qm_bg_active = false;
+    if (_this && _this->egl_data && data->egl_surface != EGL_NO_SURFACE) {
+        ok = _this->egl_data->eglMakeCurrent(_this->egl_data->egl_display, data->egl_surface, data->egl_surface, data->egl_context) ? true : false;
+    }
+    SDL_LogWarn(SDL_LOG_CATEGORY_APPLICATION, "QM background: GL context %p back on the window surface %p -> %s", (void *)data->egl_context, (void *)data->egl_surface, ok ? "ok" : "FAILED");
+    if (ok) {
+        data->backup_done = false;
+        if (data->has_swap_interval) {
+            SDL_GL_SetSwapInterval(data->swap_interval);
+        }
+    }
+    return ok;
+}
