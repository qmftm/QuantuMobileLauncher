<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/cat_game" app:iconSpaceReserved="false">
        <SeekBarPreference
            app:key="memory_mb"
            app:title="@string/memory"
            app:min="512"
            android:max="8192"
            app:seekBarIncrement="256"
            app:showSeekBarValue="true"
            app:icon="@drawable/ic_memory"
            app:iconSpaceReserved="true" />
        <ListPreference
            app:key="renderer"
            app:title="@string/renderer"
            app:entries="@array/renderer_entries"
            app:entryValues="@array/renderer_values"
            app:defaultValue="gl4es"
            app:useSimpleSummaryProvider="true"
            app:icon="@drawable/ic_brush"
            app:iconSpaceReserved="true" />
        <EditTextPreference
            app:key="renderer_lib"
            app:title="@string/renderer_lib"
            app:useSimpleSummaryProvider="true"
            app:icon="@drawable/ic_code"
            app:iconSpaceReserved="true" />
        <SeekBarPreference
            app:key="resolution_percent"
            app:title="@string/resolution"
            app:min="25"
            android:max="100"
            app:defaultValue="100"
            app:showSeekBarValue="true"
            app:icon="@drawable/ic_aspect"
            app:iconSpaceReserved="true" />
        <EditTextPreference
            app:key="jvm_args"
            app:title="@string/jvm_args"
            app:useSimpleSummaryProvider="true"
            app:icon="@drawable/ic_code"
            app:iconSpaceReserved="true" />
        <SwitchPreferenceCompat
            app:key="show_snapshots"
            app:title="@string/show_snapshots"
            app:defaultValue="false"
            app:icon="@drawable/ic_history"
            app:iconSpaceReserved="true" />
        <Preference
            app:key="game_dir"
            app:title="@string/game_dir"
            app:icon="@drawable/ic_folder_brand"
            app:iconSpaceReserved="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/cat_controls" app:iconSpaceReserved="false">
        <SeekBarPreference
            app:key="controls_opacity"
            app:title="@string/controls_opacity"
            android:max="100"
            app:defaultValue="60"
            app:showSeekBarValue="true"
            app:icon="@drawable/ic_opacity"
            app:iconSpaceReserved="true" />
        <SeekBarPreference
            app:key="mouse_sensitivity"
            app:title="@string/sensitivity"
            app:min="10"
            android:max="300"
            app:defaultValue="100"
            app:showSeekBarValue="true"
            app:icon="@drawable/ic_speed"
            app:iconSpaceReserved="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/cat_background" app:iconSpaceReserved="false">
        <Preference
            app:key="background_run"
            app:title="@string/background_title"
            app:summary="@string/background_summary"
            app:icon="@drawable/ic_speed"
            app:iconSpaceReserved="true" />
    </PreferenceCategory>

    <PreferenceCategory app:title="@string/cat_runtime" app:iconSpaceReserved="false">
        <Preference
            app:key="download_runtime"
            app:title="@string/download_runtime"
            app:summary="@string/download_runtime_summary"
            app:icon="@drawable/ic_download"
            app:iconSpaceReserved="true" />
        <Preference
            app:key="import_runtime"
            app:title="@string/import_runtime"
            app:summary="@string/import_runtime_summary"
            app:icon="@drawable/ic_upload"
            app:iconSpaceReserved="true" />
        <Preference
            app:key="manage_runtimes"
            app:title="@string/manage_runtimes"
            app:icon="@drawable/ic_java"
            app:iconSpaceReserved="true" />
        <EditTextPreference
            app:key="runtime_catalog_url"
            app:title="@string/catalog_url"
            app:useSimpleSummaryProvider="true"
            app:icon="@drawable/ic_link"
            app:iconSpaceReserved="true" />
        <Preference
            app:key="import_lwjgl"
            app:title="@string/import_lwjgl"
            app:icon="@drawable/ic_upload"
            app:iconSpaceReserved="true" />
    </PreferenceCategory>
</PreferenceScreen>
